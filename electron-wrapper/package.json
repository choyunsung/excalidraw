{
  "name": "excalidraw-desktop",
  "version": "0.1.0",
  "description": "Excalidraw packaged as a macOS desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Excalidraw --platform=darwin --arch=universal --out=dist --overwrite --icon=icon.icns --app-bundle-id=com.excalidraw.desktop --app-version=0.1.0"
  },
  "devDependencies": {
    "electron": "32.2.0",
    "electron-packager": "17.1.2"
  }
}
